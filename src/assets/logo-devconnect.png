:{\"can_configure\":true,\"should_send\":true,\"max_notification_rules_per_scan\":10,\"max_receivers_per_rule\":5},\"is_device_based\":false,\"passed\":false},\"3792512848\":{\"name\":\"3792512848\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"payment_method_instrumentation_type\":{\"pix\":\"partial_redirect\",\"paypal\":\"full_redirect\"}},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"301381018\":{\"name\":\"301381018\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"2604379743\":{\"name\":\"2604379743\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"nux_image_url\":\"https://persistent.oaistatic.com/image-gen/nux.CB3699EE.jpg\",\"nux_video_url\":\"https://persistent.oaistatic.com/image-gen/nux.CB3699EE.mov\"},\"is_device_based\":false,\"passed\":false},\"1504865540\":{\"name\":\"1504865540\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"max_file_size_mb\":25},\"is_device_based\":false,\"passed\":false},\"1171720776\":{\"name\":\"1171720776\",\"rule_id\":\"1UlyxmDKitlLIkNkLWdoOF\",\"secondary_exposures\":[],\"id_type\":\"stableID\",\"value\":{\"enabled\":false},\"is_device_based\":true,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"2133596510\":{\"name\":\"2133596510\",\"rule_id\":\"USeZCOloSU02kTe6xjZuA\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"2558204672\":{\"name\":\"2558204672\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"max_total_credit_amount_usd\":500,\"check_professional_workspace_owner_domain\":true,\"max_workspace_member_count\":5,\"run_grant_sentinel_check\":true,\"fine_print_text\":\"{amount} credit eligibility requires that the user be added as a Codex PAYG seat to a verified-domain organization and have used Codex on or before April 30, not have had a paid business seat within 90 days, not have redeemed the promotion before, not have been associated with a 