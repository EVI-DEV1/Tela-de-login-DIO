",\"connector_d3ad4b4de20147a3b5cc9be604e41d4d\",\"connector_76869538009648d5b282a4bb21c3d157\"],\"allow_all\":true},\"is_device_based\":false,\"passed\":false},\"4232437627\":{\"name\":\"4232437627\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"asdk_app_693ae33dd0f081918003ca256fe1126b\":\"Turn on the ChatGPT App in [Salesforce](https://login.salesforce.com/lightning/setup/page/feature/sales-cloud-gpt/home?topic=SalesforceGo). View [documentation](https://help.salesforce.com/s/articleView?id=005237165\u0026type=1) for setup guidance.\",\"asdk_app_697d413990c88191a2bf4799604f8f6c\":\"Turn on the ChatGPT App in [Salesforce](https://login.salesforce.com/lightning/setup/page/feature/sales-cloud-gpt/home?topic=SalesforceGo). View [documentation](https://help.salesforce.com/s/articleView?id=005237165\u0026type=1) for setup guidance.\"},\"is_device_based\":false,\"passed\":false},\"1546790766\":{\"name\":\"1546790766\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":false},\"is_device_based\":false,\"passed\":false},\"3282868491\":{\"name\":\"3282868491\",\"rule_id\":\"2HlyCvw6bnJY8OJCje8QNB:100.00:1\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"pill_text\":\"Add Sources\",\"short_text\":\"Sources\"},\"is_device_based\":false,\"passed\":true},\"1598825633\":{\"name\":\"1598825633\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"denominator\":0},\"is_device_based\":false,\"passed\":false},\"3423894538\":{\"name\":\"3423894538\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"prefilled_prompt\":\"What do you know about me? Give me a 5 paragraph summary, with headings.\",\"developer_instructions\":\"The user opened the Memory settings entrypoint to understand what ChatGPT knows about them.\\nAnswer with a concise profile summary using clear headings.\\nSeparate stable facts and preferences from softer inferences when that distinction is useful.\\nDo not list raw memory records or internal implementation details.\\nIf there is little usable memory or personalization context, say that plainly and suggest what the user can tell ChatGPT to improve personalization.\"},\"is_device_based\":false,\"passed\":false},\"3586972587\":{\"name\":\"3586972587\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"prompt\":\"The user provided feedback on a previous completion. Use it to generate a new completion. The output should be a standalone response that reflects the feedback without acknowledging it. Do not mention, suggest, or imply that this is a revision, improvement, or result of feedback. Respond in the same language as the original completion, even if the feedback is in another language. Only switch if the feedback explicitly asks you to translate the completion. Here is the feedback:\\n\"},\"is_device_based\":false,\"passed\":false},\"3923090434\":{\"name\":\"3923090434\",\"rule_id\":\"3oWlxtnoHKmdKG6BLo9K8B:100.00:5-3oWlxrImfscJrgyGage6Pz\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"2026-05-04\":[\"Slack notifications: Get notified about new findings with the Codex Slack app. Go to the Scans page and select a scan you own to set up and customize alerts by severity, path, and keywords.\"],\"changelog_latest_date\":\"2026-06-22\",\"2026-06-22\":[\"Scan editors: You can now add scan editors to your configured repositories. Scan editors can update scans, including editing threat models, configuring notification rules, and managing scan sharing.\"]},\"is_device_based\":false,\"passed\":true},\"3165814200\":{\"name\":\"3165814200\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"JITTER_MAXIMUM\":1,\"MAX_RETRY_INTERVAL\":5000,\"MIN_RETRY_INTERVAL\":300,\"RETRY_FACTOR\":1.5,\"MAX_RETRY_COUNT\":12,\"JITTER_MINIMUM\":0.5},\"is_device_based\":false,\"pass