    font-size: 20px;
  }
`</span><span>;

</span><span class="ͼv">export</span><span> </span><span class="ͼv">const</span><span> </span><span class="ͼ11">Title</span><span> </span><span class="ͼv">=</span><span> </span><span class="ͼ11">styled</span><span class="ͼv">.</span><span>h3</span><span class="ͼz">`
  margin: 0;

  color: #ffffff;

  font-size: 18px;
  font-weight: 800;
`</span><span>;

</span><span class="ͼv">export</span><span> </span><span class="ͼv">const</span><span> </span><span class="ͼ11">Messages</span><span> </span><span class="ͼv">=</span><span> </span><span class="ͼ11">styled</span><span class="ͼv">.</span><span>div</span><span class="ͼz">`
  height: 360px;

  display: flex;
  flex-direction: column;
  gap: 14px;

  overflow-y: auto;

  padding: 18px;

  scrollbar-width: thin;
`</span><span>;

</span><span class="ͼv">export</span><span> </span><span class="ͼv">const</span><span> </span><span class="ͼ11">Message</span><span> </span><span class="ͼv">=</span><span> </span><span class="ͼ11">styled</span><span class="ͼv">.</span><span>div</span><span class="ͼz">`
