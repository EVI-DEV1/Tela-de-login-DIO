\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/secure.png\",\"screen_trust_image_url\":\"https://cdn.openai.com/chatgpt/clients/bazaar/onboarding/trusted.png\"},\"android_display_zoom_scale_threshold\":1,\"late_ads_event_discard_timeout_seconds\":5,\"late_ads_event_discard_timeout_after_message_end_visibility_seconds\":3.5},\"is_device_based\":false,\"passed\":false},\"3941338778\":{\"name\":\"3941338778\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":false,\"enabledConnectors\":[]},\"is_device_based\":false,\"passed\":false},\"999809785\":{\"name\":\"999809785\",\"rule_id\":\"layerAssignment\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"3544607228\":{\"name\":\"3544607228\",\"rule_id\":\"49WhYhB0lFZnc9LdHlM25g:100.00:3-49WhYfVXTnPSSKdi6dQoMe\",\"secondary_exposures\":[{\"gate\":\"1791965523\",\"gateValue\":\"false\",\"ruleID\":\"4qORflFv21APSUsk0Bh7Er\"}],\"id_type\":\"userID\",\"value\":{\"frontend_rollout_percentage\":0,\"homepage_modal_beacon_rollout_cohorts\":[],\"backend_rollout_percentage\":0},\"is_device_based\":false,\"passed\":true},\"3131667714\":{\"name\":\"3131667714\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"supported_regions_merge_connector\":[\"us\",\"eu\",\"jp\"],\"regions\":[\"us\",\"eu\",\"jp\",\"au\",\"ae\",\"kr\",\"sg\",\"gb\",\"ca\",\"in\"]},\"is_device_based\":false,\"passed\":false},\"3317473948\":{\"name\":\"3317473948\",\"rule_id\":\"2VVKrjIwc2VcBceUZhfkJB:100.00:3\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"local_conversation_insert_fallback_disabled_system_hints\":[\"agent\"],\"polling_fallback_on_message_insertion_error\":[{\"fallback_mode\":\"final_assistant_answer\"}],\"default_interval\":5,\"model_slug_max_polling_durations\":{\"o3_pro\":1200,\"image_gen\":300,\"o1_pro\":1200},\"model_slug_interv