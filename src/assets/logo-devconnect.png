`</span><span>;

</span><span class="ͼv">export</span><span> </span><span class="ͼv">const</span><span> </span><span class="ͼ11">Avatar</span><span> </span><span class="ͼv">=</span><span> </span><span class="ͼ11">styled</span><span class="ͼv">.</span><span>img</span><span class="ͼz">`
