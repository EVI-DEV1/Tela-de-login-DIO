  object-fit: cover;
`</span><span>;

</span><span class="ͼv">export</span><span> </span><span class="ͼv">const</span><span> </span><span class="ͼ11">MessageContent</span><span> </span><span class="ͼv">=</span><span> </span><span class="ͼ11">styled</span><span class="ͼv">.</span><span>div</span><span class="ͼz">`
  min-width: 0;
